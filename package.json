{
  "name": "smart-parking-lot-system-bhaskarreddydn",
  "version": "1.0.0",
  "description": "Low-Level Design (LLD) and backend architecture in TypeScript for an urban multi-floor smart parking lot system featuring real-time spot allocation, dynamic fee calculation, multi-gate concurrency handling, and strict type safety.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "npx tsx main.ts",
    "demo": "npx tsx main.ts",
    "test": "npx tsx --test tests/**/*.test.ts",
    "test:unit": "npx tsx --test tests/unit/*.test.ts",
    "test:concurrency": "npx tsx --test tests/concurrency/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhaskarreddydn/smart-parking-lot-system-bhaskarreddydn.git"
  },
  "keywords": [
    "typescript",
    "low-level-design",
    "lld",
    "object-oriented-design",
    "smart-parking-lot",
    "system-design",
    "concurrency",
    "design-patterns",
    "solid-principles"
  ],
  "author": "Bhaskar Reddy",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">= 18.0.0"
  }
}
